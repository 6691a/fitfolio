# Normalize text files for consistent cross-platform diffs.
* text=auto

# Source and config files should stay LF on every OS.
*.py text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.ini text eol=lf
*.env.example text eol=lf
Dockerfile text eol=lf
justfile text eol=lf

# Binary files should never be line-ending normalized.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.pdf binary
*.docx binary
*.pptx binary
*.xlsx binary
*.zip binary
