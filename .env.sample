GEMINI_API_KEY=
DATABASE_URL=
REDIS_URL=

UPLOAD_DIR=
MAX_PDF_BYTES=
STRUCTURED_EXTRACT_MODEL=
DOCUMENT_CLASSIFIER_MODEL=
EMBEDDING_MODEL=
EMBEDDING_DIM=
EMBEDDING_DOCUMENT_TASK_TYPE=
EMBEDDING_QUERY_TASK_TYPE=
TIME_ZONE=Asia/Seoul
JOB_POSTING_DEFAULT_TIMEZONE=Asia/Seoul
BROWSER_HEADLESS=
AUTH_SECRET_KEY=
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=
AUTH_ALGORITHM=

# 채용공고 URL/이미지 HTTP 요청을 허용할 도메인. JSON 배열 문자열로 지정.
ALLOWED_JOB_DOMAINS=

# 문서 추출/크롤링 제한값
DOCUMENT_MIN_EXTRACTED_CHARS=
DOCUMENT_MAX_EXTRACTED_CHARS=
DOCUMENT_URL_TIMEOUT_MS=

# 디버그 파일 저장. true면 FastAPI 시작 시 UPLOAD_DIR/DOCUMENT_DEBUG_IMAGE_SUBDIR 폴더를 생성.
DOCUMENT_DEBUG_ENABLED=
DOCUMENT_DEBUG_IMAGE_SUBDIR=

# 이미지 OCR 필터. 너무 작은 로고/아이콘은 비전 호출을 건너뛴다.
DOCUMENT_MIN_IMAGE_PIXELS=
DOCUMENT_MIN_IMAGE_BYTES=
JOB_IMAGE_MIN_TALL_HEIGHT=
JOB_IMAGE_MIN_TALL_RATIO=

# 도메인별 파서 설정
SARAMIN_HOST_SUFFIX=
SARAMIN_IMAGE_HOST_SUFFIX=
SARAMIN_RELAY_AJAX_PATH=
WANTED_HOST_SUFFIX=

# Langfuse tracing. http://localhost:3000 Langfuse UI에서 프로젝트 키를 발급한 뒤 앱/워커 env에 넣는다.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# 로컬에서 `uv run ...`으로 앱을 실행하면 http://localhost:3000 을 사용한다.
# Docker compose 안의 api/worker에서 Langfuse에 붙이면 http://host.docker.internal:3000 을 사용한다.
LANGFUSE_BASE_URL=http://localhost:3000
# LANGFUSE_BASE_URL=http://host.docker.internal:3000
