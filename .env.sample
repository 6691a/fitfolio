GEMINI_API_KEY=
DATABASE_URL=postgresql+asyncpg://fitfolio:fitfolio@localhost:5432/fitfolio
REDIS_URL=redis://localhost:6379/0

UPLOAD_DIR=data/uploads
MAX_PDF_BYTES=20971520
STRUCTURED_EXTRACT_MODEL=gemini-2.5-flash
DOCUMENT_CLASSIFIER_MODEL=gemini-2.5-flash
TIME_ZONE=Asia/Seoul
JOB_POSTING_DEFAULT_TIMEZONE=Asia/Seoul

# 로컬 개발용 자리표시자다. 배포/공유 환경에서는 반드시 길고 랜덤한 값으로 교체.
AUTH_SECRET_KEY=change-me-in-local-development-secret
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=60
AUTH_ALGORITHM=HS256

# 채용공고 URL/이미지 HTTP 요청을 허용할 도메인. JSON 배열 문자열로 지정.
ALLOWED_JOB_DOMAINS=["saramin.co.kr","wanted.co.kr","jobkorea.co.kr","linkedin.com","jumpit.co.kr","rememberapp.co.kr"]

# 문서 추출/크롤링 제한값
DOCUMENT_MIN_EXTRACTED_CHARS=200
DOCUMENT_MAX_EXTRACTED_CHARS=80000
DOCUMENT_URL_TIMEOUT_MS=30000

# 디버그 파일 저장. true면 FastAPI 시작 시 UPLOAD_DIR/DOCUMENT_DEBUG_IMAGE_SUBDIR 폴더를 생성.
DOCUMENT_DEBUG_ENABLED=true
DOCUMENT_DEBUG_IMAGE_SUBDIR=debug_images

# 이미지 OCR 필터. 너무 작은 로고/아이콘은 비전 호출을 건너뛴다.
DOCUMENT_MIN_IMAGE_PIXELS=40000
DOCUMENT_MIN_IMAGE_BYTES=5120
JOB_IMAGE_MIN_TALL_HEIGHT=1000
JOB_IMAGE_MIN_TALL_RATIO=2.5

# 도메인별 파서 설정
SARAMIN_HOST_SUFFIX=saramin.co.kr
SARAMIN_IMAGE_HOST_SUFFIX=saraminimage.co.kr
SARAMIN_RELAY_AJAX_PATH=/zf_user/jobs/relay/view-ajax
WANTED_HOST_SUFFIX=wanted.co.kr

# LangSmith tracing. LANGSMITH_API_KEY는 LangSmith Settings > API Keys에서 발급한 값을 넣는다.
# 트레이싱은 이 env 변수들로 자동 동작한다(LangChain이 os.environ에서 직접 읽음). 켜려면 LANGSMITH_TRACING=true.
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=Fitfolio

# Streamlit frontend
API_BASE_URL=http://localhost:8000
PARSE_POLL_INTERVAL_SECONDS=10
